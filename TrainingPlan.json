  "tests": [
    {
      "id": "cmj",
      "name": "Sprung aus dem Stand (CMJ)",
      "unit": "cm",
      "attempts": 3,
      "instructions": "Mit der Sprung-App messen. Ausgeruht, immer gleiches Aufwärmen, der beste von 3 Versuchen zählt."
    },
    {
      "id": "approach-reach",
      "name": "Anlauf-Reichhöhe",
      "unit": "cm",
      "attempts": 3,
      "instructions": "Höchster Punkt, den du mit Anlauf an einer Wand oder am Korb berührst. Immer gleicher Anlauf."
    },
    {
      "id": "broad-jump",
      "name": "Standweitsprung",
      "unit": "cm",
      "attempts": 3,
      "instructions": "Beidbeinig aus dem Stand, Landung halten. Gemessen bis zur Ferse."
    }
  ],
  "rules": [
    "Sprünge immer zuerst, direkt nach dem Aufwärmen. Werden die Sprünge merklich schlechter, Satz beenden.",
    "Etwa 40–80 Bodenkontakte pro Sprungeinheit. Je intensiver die Sprünge, desto weniger.",
    "Auf weichem Untergrund springen (Hallenboden, Rasen), nicht auf Beton.",
    "Zieht die Patella- oder Achillessehne: Sprungvolumen halbieren. Wird es nicht besser, zum Physio.",
    "Schlaf ist das wichtigste Mittel zur Regeneration, besonders in Phase 2 und 3."
  ],
